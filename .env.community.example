# S3 Administrator - Community Edition
# Copy this file to .env and fill in the values.

# Edition (defaults to "community" — no need to change)
# NEXT_PUBLIC_EDITION="community"

# Database
DATABASE_URL="postgresql://s3admin:password@localhost:5433/s3_admin"
DATABASE_URL_DOCKER="postgresql://s3admin:password@db:5432/s3_admin"
POSTGRES_PASSWORD="password"
POSTGRES_PORT="5433"

# Auth secret (required even in community mode for session signing)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Encryption keys for S3 credentials stored in the database
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=""
# Generate with: openssl rand -hex 16
ENCRYPTION_SALT=""

# Site URL (used for links and redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
