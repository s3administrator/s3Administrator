# Environment: DEV or PROD — controls which _DEV/_PROD suffixed vars are used
ENVIRONMENT="DEV"

# Database
DATABASE_URL="postgresql://s3admin:password@localhost:5432/s3_admin"
# Required for docker-compose — set a strong random password for PROD
POSTGRES_PASSWORD=""

# Auth.js
AUTH_SECRET=""                    # Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# OAuth — env-aware: set _DEV and _PROD variants, ENVIRONMENT selects which to use
GITHUB_CLIENT_ID_DEV=""
GITHUB_CLIENT_SECRET_DEV=""
GITHUB_CLIENT_ID_PROD=""
GITHUB_CLIENT_SECRET_PROD=""

GOOGLE_CLIENT_ID_DEV=""
GOOGLE_CLIENT_SECRET_DEV=""
GOOGLE_CLIENT_ID_PROD=""
GOOGLE_CLIENT_SECRET_PROD=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=""
ENCRYPTION_SALT=""

# Admin (comma-separated emails that get admin role on login)
ADMIN_EMAILS=""

# Stripe — env-aware: add _DEV/_PROD suffixes if you have separate Stripe accounts
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
