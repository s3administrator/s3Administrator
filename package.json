{
  "name": "s3-administrator",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron .",
    "next:dev": "node scripts/next-with-env.mjs dev",
    "build": "node scripts/next-with-env.mjs build",
    "start": "node scripts/next-with-env.mjs start",
    "task-worker": "tsx src/worker/task-worker.ts",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "make-icon": "node scripts/make-icon.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dist": "npm run make-icon && npm run build:desktop && electron-builder --mac",
    "dist:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run dist",
    "dist:notarized": "npm run make-icon && npm run build:desktop && electron-builder --mac -c.mac.notarize=true"
  },
  "//dependencies": "Runtime deps live in the self-contained .next/standalone bundle (shipped verbatim via electron-builder extraResources). The ONLY package the Electron main process loads directly is embedded-postgres, so it is the only production dependency — this keeps electron-builder's dependency walker from rebuilding (and breaking) the standalone node_modules. Everything else is a devDependency, present for `next build` / dev only.",
  "dependencies": {
    "embedded-postgres": "17.9.0-beta.17"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
    "@aws-sdk/lib-storage": "^3.997.0",
    "@aws-sdk/s3-request-presigner": "^3.997.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@radix-ui/react-slider": "^1.3.6",
    "@smithy/node-http-handler": "^4.4.12",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query": "^5.90.20",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.2.4",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "prisma": "^7.4.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^3.8.5",
    "sharp": "^0.34.5",
    "shiki": "^4.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "zod": "^4.3.6"
  },
  "overrides": {
    "hono": "^4.12.2",
    "lodash": "^4.17.23",
    "fast-xml-parser": "^5.3.8",
    "minimatch": "^10.2.3",
    "qs": "^6.14.2"
  }
}
