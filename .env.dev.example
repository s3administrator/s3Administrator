ENVIRONMENT="DEV"

# Database
DATABASE_URL="postgresql://s3admin:password@localhost:5433/s3_admin"
POSTGRES_PASSWORD="password"
POSTGRES_PORT="5433"

# Auth.js
AUTH_SECRET=""                    # Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
ENABLE_ACTION_TRACKING="true"

# OAuth (DEV credentials)
GITHUB_CLIENT_ID_DEV=""
GITHUB_CLIENT_SECRET_DEV=""
GOOGLE_CLIENT_ID_DEV=""
GOOGLE_CLIENT_SECRET_DEV=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=""
ENCRYPTION_SALT=""

# Admin (comma-separated emails that get admin role on login)
ADMIN_EMAILS=""

# Stripe (test keys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
