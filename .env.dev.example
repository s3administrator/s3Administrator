ENVIRONMENT="DEV"

# Database
DATABASE_URL="postgresql://s3admin:password@localhost:5433/s3_admin"
POSTGRES_PASSWORD="password"
POSTGRES_PORT="5433"

# Auth.js
AUTH_SECRET=""                    # Generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Domain (used by Caddy local proxy)
DOMAIN="localhost"
ROOT_DOMAIN="localhost"
CADDYFILE="Caddyfile.local"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
ENABLE_ACTION_TRACKING="true"

# Server logs (app + db event logs)
SYSTEM_LOG_FILE_PATH="/app/logs/system.log"

# Thumbnail generation/storage
THUMBNAIL_S3_ENDPOINT="https://fsn1.your-objectstorage.com"
THUMBNAIL_S3_REGION="fsn1"
THUMBNAIL_S3_ACCESS_KEY="your-hetzner-access-key"
THUMBNAIL_S3_SECRET_KEY="your-hetzner-secret-key"
THUMBNAIL_S3_BUCKET="s3administrator-thumbnails-dev"
THUMBNAIL_MAX_WIDTH="480"
THUMBNAIL_URL_TTL_SECONDS="3600"

# OAuth (DEV credentials)
GITHUB_CLIENT_ID_DEV=""
GITHUB_CLIENT_SECRET_DEV=""
GOOGLE_CLIENT_ID_DEV=""
GOOGLE_CLIENT_SECRET_DEV=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=""
ENCRYPTION_SALT=""

# Admin (comma-separated emails that get admin role on login)
ADMIN_EMAILS=""

# Stripe (test keys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
