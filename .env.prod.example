ENVIRONMENT="PROD"

# Database
DATABASE_URL="postgresql://s3admin:STRONG_PASSWORD_HERE@db:5432/s3_admin"
POSTGRES_PASSWORD="STRONG_PASSWORD_HERE"
POSTGRES_PORT="5433"

# Auth.js
AUTH_SECRET=""                    # Generate with: openssl rand -base64 32
AUTH_URL="https://www.s3administrator.com"

# Domain (used by Caddy)
DOMAIN="www.s3administrator.com"
ROOT_DOMAIN="s3administrator.com"
CADDYFILE="Caddyfile.prod"

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
ENABLE_ACTION_TRACKING="true"

# Server logs (app + db event logs)
SYSTEM_LOG_FILE_PATH="/app/logs/system.log"

# Thumbnail generation/storage
THUMBNAIL_S3_ENDPOINT="https://nbg1.your-objectstorage.com"
THUMBNAIL_S3_REGION="nbg1"
THUMBNAIL_S3_ACCESS_KEY="your-hetzner-access-key"
THUMBNAIL_S3_SECRET_KEY="your-hetzner-secret-key"
THUMBNAIL_S3_BUCKET="s3administrator-thumbnails-prod"
THUMBNAIL_MAX_WIDTH="480"
THUMBNAIL_URL_TTL_SECONDS="3600"

# OAuth (PROD credentials)
GITHUB_CLIENT_ID_PROD=""
GITHUB_CLIENT_SECRET_PROD=""
GOOGLE_CLIENT_ID_PROD=""
GOOGLE_CLIENT_SECRET_PROD=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@s3administrator.com"

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=""
ENCRYPTION_SALT=""

# Admin (comma-separated emails that get admin role on login)
ADMIN_EMAILS=""

# Stripe (live keys)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
