#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - git
  - gnupg
  - lsb-release
  - make
  - ufw

write_files:
  - path: /usr/local/bin/bootstrap-s3administrator.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      if ! command -v docker >/dev/null 2>&1; then
        curl -fsSL https://get.docker.com | sh
      fi

      REQUIRED_NODE_MAJOR="${node_major_version}"
      NEED_NODE_INSTALL=0
      if ! command -v node >/dev/null 2>&1; then
        NEED_NODE_INSTALL=1
      else
        CURRENT_NODE_MAJOR="$(node -v | sed -E 's/^v([0-9]+).*/\1/')"
        if [ "$${CURRENT_NODE_MAJOR}" -lt "$${REQUIRED_NODE_MAJOR}" ]; then
          NEED_NODE_INSTALL=1
        fi
      fi

      if [ "$${NEED_NODE_INSTALL}" -eq 1 ]; then
        curl -fsSL "https://deb.nodesource.com/setup_${node_major_version}.x" | bash -
        apt-get install -y nodejs
      fi

      systemctl enable --now docker

      mkdir -p "${app_directory}"
      if [ ! -d "${app_directory}/.git" ]; then
        if [ -n "${github_token}" ]; then
          git clone --depth 1 --branch "${app_branch}" "https://x-access-token:${github_token}@github.com/${app_repo}.git" "${app_directory}"
        else
          git clone --depth 1 --branch "${app_branch}" "https://github.com/${app_repo}.git" "${app_directory}"
        fi
      else
        cd "${app_directory}"
        git fetch --all --prune
        git checkout "${app_branch}"
        git reset --hard "origin/${app_branch}"
      fi

      cat > "${app_directory}/.env" <<'ENVEOF'
      ${indent(6, app_env_content)}
      ENVEOF

      cd "${app_directory}"
      make prod

      cat > /etc/systemd/system/s3administrator.service <<'SERVICEEOF'
      [Unit]
      Description=S3 Administrator application stack
      Requires=docker.service
      After=network-online.target docker.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      WorkingDirectory=${app_directory}
      ExecStart=/usr/bin/docker compose -f docker/docker-compose.yml up -d --build
      ExecStop=/usr/bin/docker compose -f docker/docker-compose.yml down
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target
      SERVICEEOF

      systemctl daemon-reload
      systemctl enable s3administrator.service

runcmd:
  - ufw allow OpenSSH
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable
  - /usr/local/bin/bootstrap-s3administrator.sh
